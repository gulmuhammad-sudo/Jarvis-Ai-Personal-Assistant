# Copy this file to .env and fill in your keys. Keep .env private.

# What Jarvis calls you
JARVIS_USER_NAME=Sir

# The assistant's own name and look (also changeable in Settings)
# JARVIS_NAME=Jarvis
# JARVIS_THEME=dark                 # dark | light | system

# AI providers, tried in this order. Add "claude" in front to use a Claude account with Pro
# (claude auth login) or an ANTHROPIC_API_KEY.
JARVIS_PROVIDERS=gemini,groq,openrouter,deepseek
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# Live conversation (optional; uses GEMINI_API_KEY)
# JARVIS_LIVE_VOICE=Charon
# JARVIS_LIVE_MODEL=gemini-3.1-flash-live-preview,gemini-3.8-live,gemini-2.5-flash-native-audio-latest

# Classic voice (optional)
# JARVIS_VOICE=en-GB-RyanNeural
# JARVIS_URDU_VOICE=ur-PK-AsadNeural
# JARVIS_VOICE_SPEED=+5%
# JARVIS_VOICE_PITCH=-2Hz

# Daily life (optional)
# JARVIS_BRIEFING_TIME=08:00          # or off
# JARVIS_PRAYER_REMINDER_MINUTES=10
# JARVIS_PRAYER_METHOD=1              # 1 = Karachi
# JARVIS_PRAYER_SCHOOL=1              # 1 = Hanafi Asr, 0 = Shafi'i
# JARVIS_NEWS_REGION=PK
# JARVIS_BATTERY_WARN=20
